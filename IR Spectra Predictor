def hqi(actual, predicted):
    denominator = np.dot(actual, actual) * np.dot(predicted, predicted)
    if denominator == 0:
        return 0
    return np.dot(actual, predicted)**2 / denominator

def scalar(y_pred):
    max_val = max(y_pred)
    return list(y_pred / max_val)

