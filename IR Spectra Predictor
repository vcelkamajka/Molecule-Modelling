def classify_molecule(smiles):
    mol = Chem.MolFromSmiles(smiles)
    if mol is None:
        return 'invalid'

    if Fragments.fr_C_O_noCOO(mol) > 0:
        return 'carbonyl'
    elif Fragments.fr_Al_OH(mol) > 0:
        return 'alcohol'
    elif Fragments.fr_Ar_OH(mol) > 0:
        return 'phenol'
    elif Fragments.fr_NH0(mol) + Fragments.fr_NH1(mol) + Fragments.fr_NH2(mol) > 0:
        return 'amine'
    elif mol.GetRingInfo().NumRings() > 0:
        return 'aromatic'
    elif Fragments.fr_nitrile(mol) > 0:
        return 'nitrile'
    else:
        return 'alkane'

